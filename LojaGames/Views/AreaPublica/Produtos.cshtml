@model List<Produto>
<div class="hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge text-bg-success mb-3">LEVEL UP!</span>
            <h1 class="display-5">O seu próximo jogo começa <span class="accent">aqui.</span></h1>
            <p class="lead text-light-emphasis">Consoles, jogos e acessórios para quem vive o universo gamer.</p>
            <a class="btn btn-game btn-lg" href="#catalogo">Explorar produtos</a>
        </div>
        <div class="col-lg-4 text-center display-1 accent"><i class="bi bi-controller"></i></div>
    </div>
</div>
<div id="catalogo" class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="fw-bold">Catálogo gamer</h2><p class="text-secondary mb-0">Confira os produtos disponíveis na loja.</p></div>
    <span class="badge rounded-pill text-bg-dark border border-secondary">@Model.Count produto(s)</span>
</div>
<div class="row g-4">
    @if (Model.Count == 0)
    {
        <div class="col-12"><div class="alert alert-secondary">Nenhum produto encontrado nesta categoria.</div></div>
    }
    @foreach (var produto in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card card-game">
                <img src="@(string.IsNullOrWhiteSpace(produto.Imagem) ? "https://placehold.co/800x500/202638/8df542?text=GameZone" : produto.Imagem)" class="card-img-top" alt="@produto.Nome">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-2"><span class="badge text-bg-success">@produto.Categoria</span><small class="text-secondary">@produto.Plataforma</small></div>
                    <h5 class="card-title fw-bold">@produto.Nome</h5>
                    <p class="card-text text-secondary flex-grow-1">@produto.Descricao</p>
                    <div class="d-flex justify-content-between align-items-center mt-2"><span class="price">@produto.Preco.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</span><small class="text-secondary">Estoque: @produto.Estoque</small></div>
                </div>
            </div>
        </div>
    }
</div>
